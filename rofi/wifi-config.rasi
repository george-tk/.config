/**
 * Catppuccin-Mocha theme for Rofi (WiFi Menu)
 * Strictly matches main system theme logic
 */

@import "catppuccin-mocha.rasi"

* {
    /* Map your theme variables */
    background-color:             transparent;
    text-color:                   @overlay2;
    margin:                       0;
    padding:                      0;
    spacing:                      0;
}
configuration {
	font: "JetBrainsMono Nerd Font 16";
	markup-rows: true;
}
window {
    location:                     center;
    width:                        48%;
    border:                       3px;
    border-color:                 @surface0;
    border-radius:                0px;
    background-color:             #1e1e2ef2; /* 95% opacity base for high contrast */
    padding:                      0px;
}

mainbox {
    children:                     [inputbar, listview, message];
    padding:                      0px;
    background-color:             transparent;
}

inputbar {
    children:                     [ "prompt", "entry" ];
    margin:                       0px;
    padding:                      20px 24px;
    border:                       0px 0px 3px 0px;
    border-radius:                0px;
    border-color:                 @surface0;
    background-color:             transparent;
}

prompt {
    spacing:                      0;
    text-color:                   @text;
    margin:                       0px 10px 0px 0px;
    background-color:             transparent;
}

entry {
    // placeholder:                  " Search Networks";
    placeholder:                  " ";
    text-color:                   @text;
    background-color:             transparent;
}

listview {
    enabled:                      true;
    columns:                      1;
    lines:                        6;
    cycle:                        true;
    scrollbar:                    false;
    layout:                       vertical;
    spacing:                      4px;
    padding:                      10px 0px;
    background-color:             transparent;
}

/* ---- Elements ---- */
element {
    enabled:                      true;
    padding:                      12px 24px;
    border-radius:                0px;
    cursor:                       pointer;
    background-color:             transparent;
}

/* This section kills the yellow "alternate" rows */
element normal.normal,
element alternate.normal {
    background-color:             transparent;
    text-color:                   @text;
}

element selected.normal,
element selected.active {
    background-color:             @surface0;
    text-color:                   @text;
}

element-text {
    background-color:             transparent;
    text-color:                   inherit;
    vertical-align:               0.5;
    horizontal-align:             0.0;
    padding:                      0px 0px 0px 10px;
    markup:                       true;
}

/* ---- Message Area ---- */
message {
    padding:                      15px 24px;
    border-color:                 @surface0;
    border:                       1px 0px 0px 0px;
    margin:                       0px;
}

textbox {
    padding:                      15px;
    text-color:                   @text;
    background-color:             transparent;
}
