/**
 * Catppuccin-Mocha theme for Rofi
 * Inspired by hyprlock configuration
 */

@import "catppuccin-mocha.rasi"

* {
    /* Theme-specific variables */
    normal-foreground:            @overlay2;
    normal-background:            transparent;
    selected-normal-background:   transparent;
    selected-normal-foreground:   @text;
    urgent-background:            @red;
    urgent-foreground:            @base;
    active-foreground:            @blue;
    alternate-normal-foreground:  @overlay2;
    alternate-urgent-foreground:  @urgent-foreground;
    alternate-active-foreground:  @active-foreground;
    selected-active-foreground:   @blue;
    selected-urgent-background:   @red;
    selected-urgent-foreground:   @base;
    separatorcolor:               @surface1;

    background-color:             transparent;
    text-color:                   @text;

    margin:                       0;
    padding:                      0;
    spacing:                      0;
}

configuration {
    modi: "combi,files:~/.config/rofi/files.sh,win:~/.config/scripts/window_switcher.py,";
    combi-modi: "win,drun,files,";
    font: "JetBrainsMono Nerd Font 16";
    show-icons: true;
    markup-rows: true;
    combi-hide-mode-prefix: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "<b>{name}</b>";
    window-format: "<b>{c}</b>  │  {t}";
    display-drun: "      ";
    display-window: "  ";
    display-win: "  ";
    display-run: " ";
    display-files: "      ";
    display-keys: " Keys";
    display-combi: "";
    timeout {
        action: "kb-cancel";
        delay:  0;
    }
    filebrowser {
        directories-first: true;
        sorting-method:    "name";
    }
    window {
        prefer-icon-theme: true;
    }
    window-thumbnail: true;
}

window {
    location:                     center;
    width:                        48%;
    border:                       3px;
    border-color:                 @surface0;
    border-radius:                0px;
    background-color:             #1e1e2ef2; /* 95% opacity base for high contrast */
    padding:                      0px;
}

mainbox {
    children:                     [inputbar,listview, message];
    padding:                      0px;
}

inputbar {
    children:                     [ "prompt", "entry" ];
    margin:                       0px;
    padding:                      20px 24px;
    border:                       0px 0px 3px 0px;
    border-radius:                0px;
    border-color:                 @surface0;
    background-color:             transparent;
}

entry {
    placeholder:                  " Search";
    text-color:                   @text;
    background-color:             transparent;
    padding:                      0px;
}

prompt {
    spacing:    0;
    text-color: @text;
}

/* ---- Mode Switcher ---- */
mode-switcher{
    enabled:                      true;
    spacing:                      2px;
    padding:                      0px;
    margin:                       3px 0px 1px 0px;
    background-color:             transparent;
    text-color:                   @normal-foreground;
}

button {
    cursor:                       pointer;
    spacing:                      0;
    text-color:                   @normal-foreground;
    padding:                      0px;
    border-radius:                0px;
    background-color:             transparent;
    border:                       0px;
    font: "Font Awesome 7 Free 10";
}

button selected {
    background-color:             @selected-normal-background;
    text-color:                   @selected-normal-foreground;
}

/* ---- Listview ---- */
listview {
    enabled:                      true;
    columns:                      1;
    lines:                        5;
    cycle:                        true;
    dynamic:                      true;
    scrollbar:                    false;
    layout:                       vertical;
    reverse:                      false;
    fixed-height:                 false;
    fixed-columns:                true;
    spacing:                      4px;
    padding:                      10px 0px;
    margin:                       0px;
    background-color:             transparent;
    border:                       0px;
    border-color:                 @separatorcolor;
}

sidebar {
    border-color: @separatorcolor;
    border:       2px dash 0px 0px ;
}

/* ---- Element ---- */
element {
    enabled:                      true;
    padding:                      12px 24px;
    margin:                       0px;
    cursor:                       pointer;
    background-color:             transparent;
    border-radius:                0px;
    border:                       0px;
}

element normal.normal {
    background-color:            inherit;
    text-color:                  @normal-foreground;
}

element normal.urgent {
    background-color:            @urgent-background;
    text-color:                  @urgent-foreground;
}

element normal.active {
    background-color:            transparent;
    text-color:                  @active-foreground;
}

element selected.normal {
    background-color:            @surface0;
    text-color:                  @text;
}

element selected.urgent {
    background-color:            @urgent-background;
    text-color:                  @urgent-foreground;
}

element selected.active {
    background-color:            @surface0;
    text-color:                  @selected-active-foreground;
}

element alternate.normal {
    background-color:            inherit;
    text-color:                  @alternate-normal-foreground;
}

element alternate.urgent {
    background-color:            inherit;
    text-color:                  @alternate-urgent-foreground;
}

element alternate.active {
    background-color:            inherit;
    text-color:                  @alternate-active-foreground;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        42px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    padding: 0px 0px 0px 10px;
    markup:                      true;
}

/*****----- Message -----*****/
message {
    padding:                     15px 24px;
    border-color:                @surface0;
    border:                      1px 0px 0px 0px;
    background-color:            transparent;
    margin:                      0px;
    spacing:                     0px;
    border-radius:               0px;
}

textbox {
    padding:                     15px;
    margin:                      0px;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @normal-foreground;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

error-message {
    padding:                     15px;
    border-radius:               0px;
    background-color:            transparent;
    text-color:                  @normal-foreground;
}
